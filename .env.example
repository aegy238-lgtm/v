# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# VITE_AGORA_APP_ID: Agora RTC App ID for live voice room audio.
VITE_AGORA_APP_ID="d5c272d82b094c2f86ccc75df0819dfe"

# AGORA_APP_CERTIFICATE: Optional server-side Agora App Certificate for Secured Mode RTC token generation.
AGORA_APP_CERTIFICATE=""

# VITE_ADMIN_EMAIL: Exclusive Firebase Auth email address granted access to Admin Dashboard.
VITE_ADMIN_EMAIL="hhsiggidfhkgogfc@gmail.com"

# ADMIN_EMAIL & ADMIN_PASSWORD: Optional server-side Admin Dashboard email/password override.
# Configure these in Settings -> Secrets before sharing or deploying.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# Firebase Client Config (Permanently bound to shosho-chat-3e571 directly in codebase)
VITE_FIREBASE_API_KEY="AIzaSyAAr9fCp9CsfGqTOpIMIx0EyVtechkLchQ"
VITE_FIREBASE_AUTH_DOMAIN="shosho-chat-3e571.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="shosho-chat-3e571"
VITE_FIREBASE_STORAGE_BUCKET="shosho-chat-3e571.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="633233573986"
VITE_FIREBASE_APP_ID="1:633233573986:web:4bc3c29544f858b534a93b"
VITE_FIREBASE_DATABASE_ID="(default)"




